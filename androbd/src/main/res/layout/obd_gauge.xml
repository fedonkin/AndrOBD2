<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="2"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <com.github.anastr.speedviewlib.AwesomeSpeedometer
        android:id="@+id/chart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        app:sv_backgroundCircleColor="@color/bg_surface_elevated"
        app:sv_cutPadding="12dp"
        app:sv_indicatorColor="@color/accent_primary"
        app:sv_speedTextColor="@color/text_primary"
        app:sv_speedTextPosition="BOTTOM_CENTER"
        app:sv_speedometerColor="@color/accent_primary"
        app:sv_speedometerMode="TOP"
        app:sv_textColor="@color/text_secondary"
        app:sv_unitTextColor="@color/text_secondary"
        app:sv_withTremble="false" />

</LinearLayout>
