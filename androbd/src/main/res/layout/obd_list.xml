<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/obd_list"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <!-- Hairline divider under ActionBar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke_card" />

    <!-- Strict Compact Diagnostic Control Panel -->
    <LinearLayout
        android:id="@+id/data_header_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Row 1: Home, Flexible Session Badge (never overflows!), MIL & Disconnect -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_nav_home"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_btn_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/home_action"
                android:textColor="@color/text_primary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <!-- Flexible slot so long badges never push MIL or Disconnect off-screen -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tv_session_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_badge_online"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/status_online"
                    android:textColor="@color/status_online"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Compact MIL (Check Engine) Badge -->
            <LinearLayout
                android:id="@+id/mil_badge_container"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_badge_neutral"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/iv_mil_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/obd_codes"
                    android:src="@drawable/mil_off" />

                <TextView
                    android:id="@+id/tv_mil_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:maxLines="1"
                    android:text="@string/mil_ok"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_header_disconnect"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_btn_danger_soft"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/disconnect"
                android:textColor="@color/status_danger"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2: Strict Segmented Service Switcher -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_segmented_group"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/tab_svc_data"
                android:layout_width="0dp"
                android:layout_height="31dp"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_tab"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/tab_data"
                android:textColor="@color/chip_text_color"
                android:textSize="12sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />

            <TextView
                android:id="@+id/tab_svc_codes"
                android:layout_width="0dp"
                android:layout_height="31dp"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_tab"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/tab_codes"
                android:textColor="@color/chip_text_color"
                android:textSize="12sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />

            <TextView
                android:id="@+id/tab_svc_info"
                android:layout_width="0dp"
                android:layout_height="31dp"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_tab"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/tab_vehicle"
                android:textColor="@color/chip_text_color"
                android:textSize="12sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />

            <TextView
                android:id="@+id/tab_svc_ff"
                android:layout_width="0dp"
                android:layout_height="31dp"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_tab"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/tab_freezeframe"
                android:textColor="@color/chip_text_color"
                android:textSize="12sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>

        <!-- Live Data Controls -->
        <LinearLayout
            android:id="@+id/live_data_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="vertical">

            <!-- Collapsible Filter & Search Section (auto-compacts in landscape to preserve list height) -->
            <LinearLayout
                android:id="@+id/live_filter_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1-Tap Fast Polling PID Presets -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_preset_all"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_chip_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/preset_all"
                            android:textColor="@color/chip_text_color"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chip_preset_fav"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_chip_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/preset_fav"
                            android:textColor="@color/chip_text_color"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chip_preset_startup"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_chip_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/preset_startup"
                            android:textColor="@color/chip_text_color"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chip_preset_fuel"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_chip_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/preset_fuel"
                            android:textColor="@color/chip_text_color"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chip_preset_driving"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_chip_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/preset_driving"
                            android:textColor="@color/chip_text_color"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chip_preset_kia_engine"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_chip_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/preset_kia_engine"
                            android:textColor="@color/chip_text_color"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/chip_preset_kia_chassis"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_chip_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/preset_kia_chassis"
                            android:textColor="@color/chip_text_color"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/chip_preset_kia_all"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_chip_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/preset_kia_all"
                            android:textColor="@color/chip_text_color"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/chip_preset_jaguar_trans"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_chip_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/preset_jaguar_trans"
                            android:textColor="@color/chip_text_color"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/chip_preset_jaguar_vvt"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_chip_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/preset_jaguar_vvt"
                            android:textColor="@color/chip_text_color"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/chip_preset_jaguar_all"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_chip_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/preset_jaguar_all"
                            android:textColor="@color/chip_text_color"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Search Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_search_box"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@string/search_params_hint"
                        android:src="@drawable/ic_search"
                        app:tint="@color/text_tertiary" />

                    <EditText
                        android:id="@+id/et_pid_search"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/search_params_hint"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textSize="12.5sp" />

                    <ImageView
                        android:id="@+id/btn_clear_search"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:clickable="true"
                        android:contentDescription="@string/clear_search"
                        android:focusable="true"
                        android:padding="5dp"
                        android:src="@drawable/ic_close"
                        android:visibility="gone"
                        app:tint="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Scroll-Protected Telemetry & Quick View Strip (ZERO overflow on any phone width!) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_params_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/tv_voltage_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge_neutral"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="1"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_rate_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_badge_neutral"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="1"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:minWidth="8dp" />

                    <LinearLayout
                        android:id="@+id/btn_quick_gauges"
                        android:layout_width="wrap_content"
                        android:layout_height="29dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="@string/dashboard"
                            android:src="@drawable/ic_speedometer"
                            app:tint="@color/accent_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:maxLines="1"
                            android:text="@string/dashboard_short"
                            android:textColor="@color/text_primary"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_quick_chart"
                        android:layout_width="wrap_content"
                        android:layout_height="29dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="@string/chart"
                            android:src="@drawable/ic_chart"
                            app:tint="@color/accent_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:maxLines="1"
                            android:text="@string/chart"
                            android:textColor="@color/text_primary"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_quick_hud"
                        android:layout_width="wrap_content"
                        android:layout_height="29dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="@string/hud"
                            android:src="@drawable/ic_headup"
                            app:tint="@color/accent_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:maxLines="1"
                            android:text="@string/hud_short"
                            android:textColor="@color/text_primary"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 1-Second Live Data Recorder Bar -->
            <LinearLayout
                android:id="@+id/live_recorder_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btn_live_record"
                    android:layout_width="0dp"
                    android:layout_height="33dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:id="@+id/iv_live_record_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@string/live_rec_start"
                        android:src="@drawable/ic_record_dot" />

                    <TextView
                        android:id="@+id/tv_live_record_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="1"
                        android:text="@string/live_rec_start"
                        android:textColor="@color/text_primary"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_live_mark"
                    android:layout_width="wrap_content"
                    android:layout_height="33dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:contentDescription="@string/live_rec_mark"
                        android:src="@drawable/ic_flag_mark"
                        app:tint="@color/accent_primary" />

                    <TextView
                        android:id="@+id/tv_live_mark_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:maxLines="1"
                        android:text="@string/live_rec_mark"
                        android:textColor="@color/accent_primary"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_copy_live_record"
                    android:layout_width="wrap_content"
                    android:layout_height="33dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/iv_copy_record_icon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@string/live_rec_copy_all"
                        android:src="@drawable/ic_copy"
                        app:tint="@color/accent_on_primary" />

                    <TextView
                        android:id="@+id/tv_copy_record_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:maxLines="1"
                        android:text="@string/live_rec_copy_all"
                        android:textColor="@color/accent_on_primary"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Fault Codes Action Bar -->
        <LinearLayout
            android:id="@+id/codes_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Vehicle Multi-Module Selector (strictly hidden unless a custom vehicle profile is selected) -->
            <HorizontalScrollView
                android:id="@+id/vehicle_module_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/vehicle_module_chips_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_vehicle_rescan_module"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/vehicle_scan_module"
                    android:textColor="@color/text_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/btn_copy_dtc_report"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@string/copy_dtc_report"
                        android:src="@drawable/ic_copy"
                        app:tint="@color/accent_on_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/copy_dtc_report"
                        android:textColor="@color/accent_on_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_clear_codes_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_danger_soft"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@string/obd_clearcodes"
                        android:src="@drawable/ic_delete"
                        app:tint="@color/status_danger" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:maxLines="1"
                        android:text="@string/obd_clearcodes"
                        android:textColor="@color/status_danger"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke_card" />

    <!-- Freeze Frame Selector -->
    <Spinner
        android:id="@+id/ff_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:contentDescription="@string/select_fault_code"
        android:minHeight="46dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:prompt="@string/select_fault_code"
        android:spinnerMode="dialog"
        android:visibility="gone" />

    <!-- Data Cards List + Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@android:id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:choiceMode="multipleChoice"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="6dp"
            android:fastScrollEnabled="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:scrollbarStyle="outsideOverlay" />

        <TextView
            android:id="@+id/tv_list_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/empty_waiting_data"
            android:textColor="@color/text_secondary"
            android:textSize="13.5sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
