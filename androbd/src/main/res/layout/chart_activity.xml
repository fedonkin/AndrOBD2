<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <!-- Top Chart Controls Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btn_chart_back"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_btn_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/back_action"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_win_30s"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="@string/chart_win_30s"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_win_2m"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="@string/chart_win_2m"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_win_5m"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="@string/chart_win_5m"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_win_all"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="@string/chart_win_all"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_chart_pause"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_btn_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/iv_chart_pause"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@string/chart_pause"
                android:src="@drawable/ic_pause"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tv_chart_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/chart_pause"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_chart_share"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_btn_secondary"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/share"
            android:padding="7dp"
            android:src="@drawable/ic_share"
            app:tint="@color/accent_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke_card" />

    <!-- Live Interactive Series Legend Strip (tap a card to show/hide curve) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:scrollbars="none"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/chart_legend_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke_card" />

    <!-- Main Interactive Chart Canvas -->
    <com.fr3ts0n.ecu.gui.androbd.ModernChartView
        android:id="@+id/modern_chart_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tv_chart_touch_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:text="@string/chart_touch_hint"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp" />

</LinearLayout>
