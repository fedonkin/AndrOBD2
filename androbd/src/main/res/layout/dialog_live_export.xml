<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_surface"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tv_export_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/live_rec_export_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Session Metadata Summary Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp">

            <TextView
                android:id="@+id/tv_export_dialog_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_export_dialog_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Action 1: Save CSV File (Primary) -->
        <LinearLayout
            android:id="@+id/btn_export_save_csv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/live_rec_opt_save_csv_title"
                android:src="@drawable/ic_save"
                app:tint="@color/accent_on_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/live_rec_opt_save_csv_title"
                    android:textColor="@color/accent_on_primary"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_export_save_csv_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:alpha="0.9"
                    android:textColor="@color/accent_on_primary"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action 2: Share CSV File Attachment -->
        <LinearLayout
            android:id="@+id/btn_export_share_csv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_clickable"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="50dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@string/live_rec_opt_share_csv_title"
                android:src="@drawable/ic_share"
                app:tint="@color/accent_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/live_rec_opt_share_csv_title"
                    android:textColor="@color/text_primary"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_export_share_csv_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action 3: Copy Smart Compact Summary (Min/Avg/Max + Key Events) -->
        <LinearLayout
            android:id="@+id/btn_export_copy_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_clickable"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="50dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@string/live_rec_opt_copy_summary_title"
                android:src="@drawable/ic_chart"
                app:tint="@color/accent_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/live_rec_opt_copy_summary_title"
                    android:textColor="@color/text_primary"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_export_copy_summary_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action 4: Copy Full Per-Second Log -->
        <LinearLayout
            android:id="@+id/btn_export_copy_full"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_clickable"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="50dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@string/live_rec_opt_copy_full_title"
                android:src="@drawable/ic_copy"
                app:tint="@color/text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/live_rec_opt_copy_full_title"
                    android:textColor="@color/text_primary"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_export_copy_full_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Close Button -->
        <TextView
            android:id="@+id/btn_export_close"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/dialog_close"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
