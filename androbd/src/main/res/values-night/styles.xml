<resources>
    <!-- Strict Night Application Theme -->
    <style name="AppTheme" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorOnPrimary">@color/accent_on_primary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="android:statusBarColor">@color/bg_surface</item>
        <item name="android:navigationBarColor">@color/bg_screen</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:activatedBackgroundIndicator">@drawable/activated_background</item>
        <item name="actionBarStyle">@style/StrictActionBar</item>
    </style>

    <style name="StrictActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">@color/bg_surface</item>
        <item name="elevation">0dp</item>
        <item name="titleTextStyle">@style/StrictActionBarTitle</item>
    </style>

    <style name="StrictActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
