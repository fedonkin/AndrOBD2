<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_primary_soft" />
            <corners android:radius="@dimen/item_corner_radius" />
            <stroke
                android:width="1.5dp"
                android:color="@color/accent_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface" />
            <corners android:radius="@dimen/item_corner_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/stroke_card" />
        </shape>
    </item>
</selector>
